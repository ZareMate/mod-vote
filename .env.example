# Copy to .env and fill in these values (Node 22+ loads .env automatically via the start scripts).
PORT=3000
PUBLIC_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated role IDs. Admin role also grants voting access.
DISCORD_VOTER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
# Set to 1 when you trust an HTTPS reverse proxy such as nginx.
TRUST_PROXY=0
# Optional SQLite database path
DATABASE_PATH=./data/votes.sqlite
